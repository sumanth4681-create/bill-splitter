# Copy to .env and fill in locally. Never commit .env or the key file.
GOOGLE_APPLICATION_CREDENTIALS=
DOCAI_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
# live = call Google (and save the response); replay = only use saved responses
OCR_MODE=live
API_URL=http://localhost:8000
# Local reader (LM Studio, OpenAI-compatible server): run `lms server start`
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b

# Address friends use to reach the screen (same Wi-Fi: http://<your-mac-ip>:8501)
APP_URL=http://localhost:8501
